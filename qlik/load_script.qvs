///$tab Main
// Commercial analytics for an animal-health distributor (synthetic data, see ../generator).
// Qlik Sense / Qlik Cloud. Upload the CSVs from ../data to the space's DataFiles connection,
// or change vPath to a folder connection on Qlik Sense Desktop/Enterprise.
SET ThousandSep=' ';
SET DecimalSep=',';
SET MoneyFormat='#.##0,00 €;-#.##0,00 €';
SET DateFormat='YYYY-MM-DD';
SET FirstWeekDay=0;
SET BrokenWeeks=0;
SET ReferenceDay=4;

LET vPath   = 'lib://DataFiles/';
// Snapshot date of the data set: aging and recency are measured against it, not Today(),
// so the app gives the same answers whenever it is reloaded.
LET vAsOf   = Num(MakeDate(2026, 9, 30));

///$tab Dimensions
Reps:
LOAD
    rep_id                          AS RepID,
    rep_name                        AS [Sales Rep],
    region                          AS [Rep Region],
    If(Len(left_on) > 0, Date#(left_on, 'YYYY-MM-DD')) AS [Rep Left On]
FROM [$(vPath)reps.csv] (txt, utf8, embedded labels, delimiter is ',', msq);

Products:
LOAD
    sku                             AS SKU,
    category                        AS Category,
    list_price_eur                  AS [List Price],
    unit_cost_eur                   AS [Unit Cost]
FROM [$(vPath)products.csv] (txt, utf8, embedded labels, delimiter is ',', msq);

Customers:
LOAD
    customer_id                     AS CustomerID,
    customer_name                   AS Customer,
    segment                         AS Segment,
    region                          AS Region,
    district                        AS District,
    rep_id                          AS [Account Rep ID],
    Date#(customer_since, 'YYYY-MM-DD') AS [Customer Since],
    payment_terms_days              AS [Payment Terms]
FROM [$(vPath)customers.csv] (txt, utf8, embedded labels, delimiter is ',', msq);

///$tab Facts
// One concatenated fact table (Sale, Visit, Invoice rows) keeps a single key path
// CustomerID / RepID / %Date and avoids synthetic keys and loops.
OrderHeader:
MAPPING LOAD order_id, customer_id & '|' & rep_id & '|' & order_date
FROM [$(vPath)orders.csv] (txt, utf8, embedded labels, delimiter is ',', msq);

Facts:
LOAD
    'Sale'                                                   AS FactType,
    order_id                                                 AS OrderID,
    SubField(ApplyMap('OrderHeader', order_id), '|', 1)      AS CustomerID,
    SubField(ApplyMap('OrderHeader', order_id), '|', 2)      AS RepID,
    Date(Date#(SubField(ApplyMap('OrderHeader', order_id), '|', 3), 'YYYY-MM-DD')) AS %Date,
    sku                                                      AS SKU,
    quantity                                                 AS Quantity,
    quantity * list_price_eur                                AS GrossAmount,
    quantity * net_price_eur                                 AS NetAmount,
    quantity * unit_cost_eur                                 AS CostAmount
FROM [$(vPath)order_lines.csv] (txt, utf8, embedded labels, delimiter is ',', msq);

Concatenate (Facts)
LOAD
    'Visit'                                  AS FactType,
    customer_id                              AS CustomerID,
    rep_id                                   AS RepID,
    Date(Date#(visit_date, 'YYYY-MM-DD'))    AS %Date,
    visit_type                               AS [Visit Type],
    1                                        AS VisitCount
FROM [$(vPath)visits.csv] (txt, utf8, embedded labels, delimiter is ',', msq);

Payments:
MAPPING LOAD invoice_id, payment_date
FROM [$(vPath)payments.csv] (txt, utf8, embedded labels, delimiter is ',', msq);

InvoiceTmp:
LOAD
    invoice_id,
    order_id,
    Date#(invoice_date, 'YYYY-MM-DD')                         AS InvoiceDate,
    Date#(due_date, 'YYYY-MM-DD')                             AS DueDate,
    amount_eur,
    Date#(ApplyMap('Payments', invoice_id, Null()), 'YYYY-MM-DD') AS PaidDate
FROM [$(vPath)invoices.csv] (txt, utf8, embedded labels, delimiter is ',', msq);

Concatenate (Facts)
LOAD
    'Invoice'                                                AS FactType,
    invoice_id                                               AS InvoiceID,
    order_id                                                 AS OrderID,
    SubField(ApplyMap('OrderHeader', order_id), '|', 1)      AS CustomerID,
    SubField(ApplyMap('OrderHeader', order_id), '|', 2)      AS RepID,
    Date(InvoiceDate)                                        AS %Date,
    Date(DueDate)                                            AS [Due Date],
    Date(PaidDate)                                           AS [Paid Date],
    amount_eur                                               AS InvoiceAmount,
    If(IsNull(PaidDate), amount_eur, 0)                      AS OpenAmount,
    If(Not IsNull(PaidDate), PaidDate - DueDate)             AS DaysLate,
    // Aging of what is still open on the snapshot date
    If(IsNull(PaidDate),
        If($(vAsOf) <= DueDate, 'Not due',
        If($(vAsOf) - DueDate <= 30, '1-30',
        If($(vAsOf) - DueDate <= 60, '31-60',
        If($(vAsOf) - DueDate <= 90, '61-90', '90+'))))) AS [Aging Bucket]
RESIDENT InvoiceTmp;

DROP TABLE InvoiceTmp;

///$tab Customer flags
// Recency per customer on the snapshot date, used for the churn-risk list.
Recency:
LOAD
    CustomerID,
    Max(If(FactType = 'Visit', %Date)) AS LastVisitTmp,
    Max(If(FactType = 'Sale',  %Date)) AS LastOrderTmp
RESIDENT Facts
GROUP BY CustomerID;

LEFT JOIN (Customers)
LOAD
    CustomerID,
    Date(LastVisitTmp)                                   AS [Last Visit],
    Date(LastOrderTmp)                                   AS [Last Order],
    $(vAsOf) - LastVisitTmp                              AS [Days Since Visit],
    $(vAsOf) - LastOrderTmp                              AS [Days Since Order],
    Class($(vAsOf) - LastVisitTmp, 30, 'days')           AS [Days Since Visit Band],   // 30-day bands for a histogram
    If($(vAsOf) - LastVisitTmp > 60, 'No visit 60+ days', 'Visited in last 60 days') AS [Visit Recency],
    If($(vAsOf) - LastOrderTmp <= 90, 'Active', If($(vAsOf) - LastOrderTmp <= 180, 'Lapsing', 'Lost')) AS [Customer Status]
RESIDENT Recency;

DROP TABLE Recency;

///$tab Calendar
TempRange:
LOAD Min(%Date) AS MinD, Max(%Date) AS MaxD RESIDENT Facts;
LET vMinD = Num(Peek('MinD', 0, 'TempRange'));
LET vMaxD = Num(Peek('MaxD', 0, 'TempRange'));
DROP TABLE TempRange;

MasterCalendar:
LOAD
    Date(d)                                       AS %Date,
    Year(d)                                       AS Year,
    'Q' & Ceil(Month(d) / 3)                      AS Quarter,
    Month(d)                                      AS Month,
    Date(MonthStart(d), 'MMM YYYY')               AS YearMonth,
    Week(d)                                       AS Week,
    WeekDay(d)                                    AS Weekday,
    // Year-to-date flags relative to the snapshot, for set analysis (no date arithmetic in charts)
    If(InYearToDate(d, $(vAsOf), 0), 1, 0)       AS _YTD,
    If(InYearToDate(d, $(vAsOf), -1), 1, 0)      AS _PYTD,
    If(d > $(vAsOf) - 365, 1, 0)                  AS _L12M,
    If(d > $(vAsOf) - 730 And d <= $(vAsOf) - 365, 1, 0) AS _P12M;
LOAD $(vMinD) + IterNo() - 1 AS d
AUTOGENERATE 1 WHILE $(vMinD) + IterNo() - 1 <= $(vMaxD);

///$tab Variables
// Master measures are listed in master_items.md; variables keep the expressions in one place
// so the same logic can be pasted into chart measures and KPI objects.
SET vRevenue       = Sum({<FactType={'Sale'}>} NetAmount);
SET vGross         = Sum({<FactType={'Sale'}>} GrossAmount);
SET vMargin        = Sum({<FactType={'Sale'}>} NetAmount - CostAmount);
SET vRevenueYTD    = Sum({<FactType={'Sale'}, _YTD={1}, Year=, Month=, YearMonth=, Quarter=>} NetAmount);
SET vRevenuePYTD   = Sum({<FactType={'Sale'}, _PYTD={1}, Year=, Month=, YearMonth=, Quarter=>} NetAmount);
SET vBuyers        = Count({<FactType={'Sale'}>} DISTINCT CustomerID);
SET vVisits        = Sum({<FactType={'Visit'}>} VisitCount);
SET vOpen          = Sum({<FactType={'Invoice'}, %Date=, Year=, Month=, YearMonth=, Quarter=>} OpenAmount);
SET vOverdue90     = Sum({<FactType={'Invoice'}, [Aging Bucket]={'90+'}, %Date=, Year=, Month=, YearMonth=, Quarter=>} OpenAmount);
