table fct_sales
	lineageTag: 68d04650-b01e-4066-9902-be475f4a197e

	/// Sales after discounts and returns: the revenue every margin and growth measure starts from.
	measure 'Net Revenue' = SUM ( fct_sales[net_amount] )
		formatString: #,0 €
		lineageTag: d16ec226-d089-47aa-8f2a-a5cf3daba3ea

	/// Sales at list price, before discount.
	measure 'Gross Sales' = SUM ( fct_sales[gross_amount] )
		formatString: #,0 €
		lineageTag: bc189d58-0ff8-4e88-b3c2-cbee7657f0d1

	/// Cost of the goods sold in the period.
	measure 'Cost of Sales' = SUM ( fct_sales[cost_amount] )
		formatString: #,0 €
		lineageTag: 00fbee5a-2aeb-4a80-b3c6-28aee7368c9e

	/// Units invoiced in the period.
	measure 'Units Sold' = SUM ( fct_sales[quantity] )
		formatString: #,0
		lineageTag: 39764b1a-e4c4-4aac-b8b5-f0a929ba2b59

	/// Net revenue minus cost of sales.
	measure 'Gross Margin' = [Net Revenue] - [Cost of Sales]
		formatString: #,0 €
		lineageTag: 06d888b8-1a78-4a01-a56e-d800344c491c

	/// Gross margin as a share of net revenue.
	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Net Revenue] )
		formatString: 0.0%
		lineageTag: 5ba8062f-1187-4f70-b5d0-128e3e520a84

	/// Gross sales minus net revenue: what discounts and returns cost in the period.
	measure 'Discount Amount' = [Gross Sales] - [Net Revenue]
		formatString: #,0 €
		lineageTag: f79c8661-4a8e-48ca-8485-169f49eb962b

	/// 1 - net / gross, as in the Qlik master item.
	measure 'Discount %' = DIVIDE ( [Discount Amount], [Gross Sales] )
		formatString: 0.0%
		lineageTag: 79d74039-1952-4ee0-b077-1362c72fd4cd

	/// Year to date up to the last date in context. With no date filter that is 1 Jan to 30 Sep 2026, because dim_date ends on the snapshot date.
	measure 'Revenue YTD' = CALCULATE ( [Net Revenue], DATESYTD ( dim_date[date_day] ) )
		formatString: #,0 €
		lineageTag: b49a1f2d-041b-40be-9bf4-d8929440d5c1

	/// Net revenue over the same year-to-date window of the previous year.
	measure 'Revenue PYTD' = CALCULATE ( [Net Revenue], SAMEPERIODLASTYEAR ( DATESYTD ( dim_date[date_day] ) ) )
		formatString: #,0 €
		lineageTag: 160beb50-3e50-45ac-8a4c-69f2d6cc91c9

	/// Year-to-date growth of net revenue against the previous year.
	measure 'Revenue YTD vs PY %' = DIVIDE ( [Revenue YTD] - [Revenue PYTD], [Revenue PYTD] )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: df674c40-1d67-4d5e-bfb0-0fe573c41d1d

	/// Net revenue in the same period of the previous year.
	measure 'Revenue PY' = CALCULATE ( [Net Revenue], SAMEPERIODLASTYEAR ( dim_date[date_day] ) )
		formatString: #,0 €
		lineageTag: b59a24db-e902-43f1-a20e-6b9ca668ea6e

	/// Net revenue growth against the same period of the previous year.
	measure 'Revenue vs PY %' = DIVIDE ( [Net Revenue] - [Revenue PY], [Revenue PY] )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: ce869615-83fd-433a-93a6-c9e1cc2acf85

	/// The 365 days ending on the snapshot date, whatever the date filter.
	measure 'Revenue L12M' =
			VAR LastDay = CALCULATE ( MAX ( dim_date[date_day] ), ALL ( dim_date ) )
			RETURN
				CALCULATE ( [Net Revenue], DATESINPERIOD ( dim_date[date_day], LastDay, -365, DAY ) )
		formatString: #,0 €
		lineageTag: 73413a4e-a0de-4d7d-a359-1d2c076a3933

	/// Last-12-month revenue of customers with no visit in 60 days: revenue the coverage gap puts at risk.
	measure 'Revenue L12M at Risk' = CALCULATE ( [Revenue L12M], dim_customer[visit_recency] = "No visit 60+ days" )
		formatString: #,0 €
		lineageTag: 5800b4d8-06c2-4306-bedb-f27cc51f112d

	/// Distinct customers with at least one sale in the period.
	measure 'Buying Customers' = DISTINCTCOUNT ( fct_sales[customer_id] )
		formatString: #,0
		lineageTag: af3cb211-d7b0-406a-a6fa-bd00bcfb363e

	/// Buyers in the period over all customers in the selected region, segment or account rep (positivação).
	measure 'Coverage %' =
			DIVIDE (
				[Buying Customers],
				CALCULATE ( COUNTROWS ( dim_customer ), TREATAS ( VALUES ( dim_rep[rep_id] ), dim_customer[account_rep_id] ) )
			)
		formatString: 0.0%
		lineageTag: dcd43a59-7d7e-45d1-8f57-1eb338426d56

	/// Net revenue divided by the number of buying customers.
	measure 'Revenue per Customer' = DIVIDE ( [Net Revenue], [Buying Customers] )
		formatString: #,0 €
		lineageTag: eecc6bb0-6efd-4ee9-bdd6-e1deeaaf389e

	/// Net revenue divided by the number of sales visits in the period.
	measure 'Revenue per Visit' = DIVIDE ( [Net Revenue], [Visits] )
		formatString: #,0 €
		lineageTag: 554c5ed3-b8ac-4b09-a893-9913c9a2e0d4

	/// One-sentence answer for the Overview page: total change on last year and the weakest region. Changes with the slicers.
	measure 'Headline Overview' =
			VAR Total = [Revenue YTD vs PY %]
			VAR ByRegion =
				FILTER (
					ADDCOLUMNS ( VALUES ( dim_customer[region] ), "@chg", [Revenue YTD vs PY %] ),
					NOT ISBLANK ( [@chg] )
				)
			VAR Worst = TOPN ( 1, ByRegion, [@chg], ASC )
			VAR WorstRegion = MAXX ( Worst, dim_customer[region] )
			VAR WorstChg = MAXX ( Worst, [@chg] )
			RETURN
				IF (
					ISBLANK ( Total ),
					"No sales in this selection.",
					"Revenue is " & FORMAT ( Total, "+0.0%;-0.0%" ) & " on the same months of last year"
						& IF (
							COUNTROWS ( ByRegion ) > 1,
							". Weakest region: " & WorstRegion & " at " & FORMAT ( WorstChg, "+0.0%;-0.0%" ) & ".",
							"."
						)
				)
		isHidden
		displayFolder: Story
		lineageTag: 0f4aa438-37d0-5729-9159-d147aed627aa

	/// One-sentence answer for the Coverage page: visits and revenue against last year, and customers left without a visit.
	measure 'Headline Coverage' =
			VAR Rev = [Revenue YTD vs PY %]
			VAR Vis = [Visits YTD vs PY %]
			VAR NoVisit = [Customers Without Visit 60+]
			RETURN
				IF (
					ISBLANK ( Rev ),
					"No sales in this selection.",
					"Visits " & FORMAT ( Vis, "+0.0%;-0.0%" ) & " and revenue " & FORMAT ( Rev, "+0.0%;-0.0%" )
						& " on last year. " & FORMAT ( NoVisit, "#,0" ) & " customers have had no visit for 60+ days."
				)
		isHidden
		displayFolder: Story
		lineageTag: 8b28b885-3216-5d1d-9017-25c55063ddf1

	/// One-sentence answer for the Pricing page: the rep with the highest discount against everyone else.
	measure 'Headline Pricing' =
			VAR ByRep =
				FILTER (
					ADDCOLUMNS ( VALUES ( dim_rep[rep_name] ), "@disc", [Discount %], "@gm", [Gross Margin %] ),
					NOT ISBLANK ( [@disc] )
				)
			VAR Top1 = TOPN ( 1, ByRep, [@disc], DESC )
			VAR TopRep = MAXX ( Top1, dim_rep[rep_name] )
			VAR TopDisc = MAXX ( Top1, [@disc] )
			VAR TopGm = MAXX ( Top1, [@gm] )
			VAR Others = CALCULATE ( [Discount %], KEEPFILTERS ( dim_rep[rep_name] <> TopRep ) )
			RETURN
				IF (
					COUNTROWS ( ByRep ) < 2,
					"Discount " & FORMAT ( [Discount %], "0.0%" ) & ", gross margin " & FORMAT ( [Gross Margin %], "0.0%" ) & ".",
					TopRep & " gives " & FORMAT ( TopDisc, "0.0%" ) & " discount against " & FORMAT ( Others, "0.0%" )
						& " for the other reps, and keeps " & FORMAT ( TopGm, "0.0%" ) & " gross margin."
				)
		isHidden
		displayFolder: Story
		lineageTag: b2e3712f-8fd6-5a4b-84fc-0b9b59d41471

	/// One-sentence answer for the Receivables page: what is overdue 90+ days and which segment holds it.
	measure 'Headline Receivables' =
			VAR BySeg =
				FILTER (
					ADDCOLUMNS ( VALUES ( dim_customer[segment] ), "@share", [Overdue 90+ Share], "@late", [Avg Days Late] ),
					NOT ISBLANK ( [@share] )
				)
			VAR Top1 = TOPN ( 1, BySeg, [@share], DESC )
			VAR Seg = MAXX ( Top1, dim_customer[segment] )
			RETURN
				IF (
					ISBLANK ( [Overdue 90+] ),
					"Nothing is overdue 90+ days in this selection.",
					FORMAT ( [Overdue 90+], "#,0 €" ) & " is overdue 90+ days. The segment " & Seg & " holds "
						& FORMAT ( MAXX ( Top1, [@share] ), "0.0%" ) & " of it and pays "
						& FORMAT ( MAXX ( Top1, [@late] ), "0" ) & " days late on average."
				)
		isHidden
		displayFolder: Story
		lineageTag: e4944138-cb8f-53de-a135-0db4895e62d3

	/// Sentence at the top of the Customer detail drill-through page.
	measure 'Customer Headline' =
			VAR CustName = SELECTEDVALUE ( dim_customer[customer_name] )
			VAR DaysNoVisit = SELECTEDVALUE ( dim_customer[days_since_visit] )
			RETURN
				IF (
					ISBLANK ( CustName ),
					"Right-click a customer on any page and choose Drill through > Customer detail.",
					CustName & ", " & SELECTEDVALUE ( dim_customer[segment] ) & " in " & SELECTEDVALUE ( dim_customer[region] ) & ". "
						& IF ( ISBLANK ( DaysNoVisit ), "No visit on record", "Last visit " & DaysNoVisit & " days ago" )
						& ", " & FORMAT ( [Revenue L12M], "#,0 €" ) & " bought in the last 12 months, "
						& FORMAT ( [Overdue 90+], "#,0 €" ) & " overdue 90+ days."
				)
		isHidden
		displayFolder: Story
		lineageTag: b7ebde86-5860-5743-95fe-d7a368d6df46

	/// Title of the Overview monthly chart; follows the Metric field parameter.
	measure 'Metric Chart Title' =
			VAR Pick = SELECTEDVALUE ( Metric[Metric Order], 0 )
			RETURN
				SWITCH ( Pick, 1, "Gross margin %", 2, "Buying customers", 3, "Visits", "Net revenue" )
					& " by month, one line per year"
		isHidden
		displayFolder: Story
		lineageTag: 98ec92bd-385e-5b9d-9d44-8a68a3c77017

	/// Subtitle of the Overview monthly chart.
	measure 'Metric Chart Subtitle' =
			VAR Pick = SELECTEDVALUE ( Metric[Metric Order], 0 )
			RETURN
				SWITCH (
					Pick,
					1, "Net revenue minus cost, as a share of net revenue",
					2, "Distinct customers with at least one order in the month",
					3, "Sales rep visits in the month",
					"€, excluding VAT"
				) & ". 2026 runs to September. Change the measure with the Metric filter"
		isHidden
		displayFolder: Story
		lineageTag: e0ffbf27-2372-59e5-99ff-0924a15bd3a3

	column date_day
		dataType: dateTime
