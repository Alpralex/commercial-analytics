createOrReplace

	/// Folder that holds the Parquet files, with a trailing backslash. Change it in Transform data > Manage parameters.
	expression DataFolder = "C:\\commercial-analytics\\powerbi\\data\\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

		annotation PBI_ResultType = Text

	table dim_date
		dataCategory: Time

		column date_day
			dataType: dateTime
			isKey
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: date_day

		column year_number
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: year_number

		column quarter_label
			dataType: string
			summarizeBy: none
			sourceColumn: quarter_label

		column month_number
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: month_number

		column month_name
			dataType: string
			summarizeBy: none
			sourceColumn: month_name
			sortByColumn: month_number

		column month_start
			dataType: dateTime
			formatString: mmm yyyy
			summarizeBy: none
			sourceColumn: month_start

		column year_month
			dataType: string
			summarizeBy: none
			sourceColumn: year_month

		column weekday_number
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: weekday_number

		column season
			dataType: string
			summarizeBy: none
			sourceColumn: season

		partition dim_date = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "dim_date.parquet" ) )
					in
						Source

	table dim_customer

		measure 'Customers' = COUNTROWS ( dim_customer )
			formatString: #,0

		/// Customers whose last visit was more than 60 days before the snapshot date (30 Sep 2026).
		measure 'Customers Without Visit 60+' = CALCULATE ( COUNTROWS ( dim_customer ), dim_customer[visit_recency] = "No visit 60+ days" )
			formatString: #,0

		/// No visit for 60+ days and still ordering (last order within 180 days), as in the Qlik master item.
		measure 'Customers at Risk' =
				CALCULATE (
					COUNTROWS ( dim_customer ),
					dim_customer[visit_recency] = "No visit 60+ days",
					dim_customer[customer_status] IN { "Active", "Lapsing" }
				)
			formatString: #,0

		column customer_id
			dataType: string
			isKey
			summarizeBy: none
			sourceColumn: customer_id

		column customer_name
			dataType: string
			summarizeBy: none
			sourceColumn: customer_name

		column segment
			dataType: string
			summarizeBy: none
			sourceColumn: segment

		column region
			dataType: string
			summarizeBy: none
			sourceColumn: region

		column district
			dataType: string
			summarizeBy: none
			sourceColumn: district

		column account_rep_id
			dataType: string
			summarizeBy: none
			sourceColumn: account_rep_id

		column customer_since
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: customer_since

		column payment_terms_days
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: payment_terms_days

		column last_visit_date
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: last_visit_date

		column last_order_date
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: last_order_date

		column days_since_visit
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: days_since_visit

		column days_since_order
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: days_since_order

		column days_since_visit_band
			dataType: string
			summarizeBy: none
			sourceColumn: days_since_visit_band

		column visit_recency
			dataType: string
			summarizeBy: none
			sourceColumn: visit_recency

		column customer_status
			dataType: string
			summarizeBy: none
			sourceColumn: customer_status

		column revenue_l12m
			dataType: double
			formatString: #,0 €
			summarizeBy: none
			sourceColumn: revenue_l12m

		partition dim_customer = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "dim_customer.parquet" ) )
					in
						Source

	table dim_rep

		column rep_id
			dataType: string
			isKey
			summarizeBy: none
			sourceColumn: rep_id

		column rep_name
			dataType: string
			summarizeBy: none
			sourceColumn: rep_name

		column rep_region
			dataType: string
			summarizeBy: none
			sourceColumn: rep_region

		column left_on
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: left_on

		column is_active
			dataType: boolean
			summarizeBy: none
			sourceColumn: is_active

		partition dim_rep = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "dim_rep.parquet" ) )
					in
						Source

	table dim_category

		column category
			dataType: string
			isKey
			summarizeBy: none
			sourceColumn: category

		column sku_count
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: sku_count

		column avg_list_margin_pct
			dataType: double
			formatString: 0.0%
			summarizeBy: none
			sourceColumn: avg_list_margin_pct

		partition dim_category = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "dim_category.parquet" ) )
					in
						Source

	table fct_sales

		measure 'Net Revenue' = SUM ( fct_sales[net_amount] )
			formatString: #,0 €

		/// Sales at list price, before discount.
		measure 'Gross Sales' = SUM ( fct_sales[gross_amount] )
			formatString: #,0 €

		measure 'Cost of Sales' = SUM ( fct_sales[cost_amount] )
			formatString: #,0 €

		measure 'Units Sold' = SUM ( fct_sales[quantity] )
			formatString: #,0

		measure 'Gross Margin' = [Net Revenue] - [Cost of Sales]
			formatString: #,0 €

		measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Net Revenue] )
			formatString: 0.0%

		measure 'Discount Amount' = [Gross Sales] - [Net Revenue]
			formatString: #,0 €

		/// 1 - net / gross, as in the Qlik master item.
		measure 'Discount %' = DIVIDE ( [Discount Amount], [Gross Sales] )
			formatString: 0.0%

		/// Year to date up to the last date in context. With no date filter that is 1 Jan to 30 Sep 2026, because dim_date ends on the snapshot date.
		measure 'Revenue YTD' = CALCULATE ( [Net Revenue], DATESYTD ( dim_date[date_day] ) )
			formatString: #,0 €

		measure 'Revenue PYTD' = CALCULATE ( [Net Revenue], SAMEPERIODLASTYEAR ( DATESYTD ( dim_date[date_day] ) ) )
			formatString: #,0 €

		measure 'Revenue YTD vs PY %' = DIVIDE ( [Revenue YTD] - [Revenue PYTD], [Revenue PYTD] )
			formatString: +0.0%;-0.0%;0.0%

		measure 'Revenue PY' = CALCULATE ( [Net Revenue], SAMEPERIODLASTYEAR ( dim_date[date_day] ) )
			formatString: #,0 €

		measure 'Revenue vs PY %' = DIVIDE ( [Net Revenue] - [Revenue PY], [Revenue PY] )
			formatString: +0.0%;-0.0%;0.0%

		/// The 365 days ending on the snapshot date, whatever the date filter.
		measure 'Revenue L12M' =
				VAR LastDay = CALCULATE ( MAX ( dim_date[date_day] ), ALL ( dim_date ) )
				RETURN
					CALCULATE ( [Net Revenue], DATESINPERIOD ( dim_date[date_day], LastDay, -365, DAY ) )
			formatString: #,0 €

		measure 'Revenue L12M at Risk' = CALCULATE ( [Revenue L12M], dim_customer[visit_recency] = "No visit 60+ days" )
			formatString: #,0 €

		measure 'Buying Customers' = DISTINCTCOUNT ( fct_sales[customer_id] )
			formatString: #,0

		/// Buyers in the period over all customers in the selected region, segment or account rep (positivação).
		measure 'Coverage %' =
				DIVIDE (
					[Buying Customers],
					CALCULATE ( COUNTROWS ( dim_customer ), TREATAS ( VALUES ( dim_rep[rep_id] ), dim_customer[account_rep_id] ) )
				)
			formatString: 0.0%

		measure 'Revenue per Customer' = DIVIDE ( [Net Revenue], [Buying Customers] )
			formatString: #,0 €

		measure 'Revenue per Visit' = DIVIDE ( [Net Revenue], [Visits] )
			formatString: #,0 €

		column date_day
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: date_day

		column customer_id
			dataType: string
			summarizeBy: none
			sourceColumn: customer_id

		column rep_id
			dataType: string
			summarizeBy: none
			sourceColumn: rep_id

		column category
			dataType: string
			summarizeBy: none
			sourceColumn: category

		column order_lines
			dataType: int64
			formatString: #,0
			summarizeBy: sum
			sourceColumn: order_lines

		column quantity
			dataType: int64
			formatString: #,0
			summarizeBy: sum
			sourceColumn: quantity

		column gross_amount
			dataType: double
			formatString: #,0 €
			summarizeBy: sum
			sourceColumn: gross_amount

		column net_amount
			dataType: double
			formatString: #,0 €
			summarizeBy: sum
			sourceColumn: net_amount

		column cost_amount
			dataType: double
			formatString: #,0 €
			summarizeBy: sum
			sourceColumn: cost_amount

		partition fct_sales = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "fct_sales.parquet" ) )
					in
						Source

	table fct_visits

		measure 'Visits' = COUNTROWS ( fct_visits )
			formatString: #,0

		measure 'Visits PY' = CALCULATE ( [Visits], SAMEPERIODLASTYEAR ( dim_date[date_day] ) )
			formatString: #,0

		measure 'Visits YTD' = CALCULATE ( [Visits], DATESYTD ( dim_date[date_day] ) )
			formatString: #,0

		measure 'Visits PYTD' = CALCULATE ( [Visits], SAMEPERIODLASTYEAR ( DATESYTD ( dim_date[date_day] ) ) )
			formatString: #,0

		measure 'Visits YTD vs PY %' = DIVIDE ( [Visits YTD] - [Visits PYTD], [Visits PYTD] )
			formatString: +0.0%;-0.0%;0.0%

		column date_day
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: date_day

		column customer_id
			dataType: string
			summarizeBy: none
			sourceColumn: customer_id

		column rep_id
			dataType: string
			summarizeBy: none
			sourceColumn: rep_id

		column visit_type
			dataType: string
			summarizeBy: none
			sourceColumn: visit_type

		partition fct_visits = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "fct_visits.parquet" ) )
					in
						Source

	table fct_invoices

		/// Invoiced amount including 23% VAT.
		measure 'Billed Amount' = SUM ( fct_invoices[invoice_amount] )
			formatString: #,0 €

		measure 'Billing Share' = DIVIDE ( [Billed Amount], CALCULATE ( [Billed Amount], ALL ( dim_customer ) ) )
			formatString: 0.0%

		/// Unpaid on the snapshot date (30 Sep 2026). Ignores date filters on purpose, like the Qlik master item.
		measure 'Open Receivables' = CALCULATE ( SUM ( fct_invoices[open_amount] ), REMOVEFILTERS ( dim_date ) )
			formatString: #,0 €

		measure 'Overdue 90+' = CALCULATE ( SUM ( fct_invoices[open_amount] ), fct_invoices[aging_bucket] = "90+", REMOVEFILTERS ( dim_date ) )
			formatString: #,0 €

		/// Share of all 90+ overdue receivables.
		measure 'Overdue 90+ Share' = DIVIDE ( [Overdue 90+], CALCULATE ( [Overdue 90+], ALL ( dim_customer ) ) )
			formatString: 0.0%

		/// Payment date minus due date, paid invoices only.
		measure 'Avg Days Late' = AVERAGE ( fct_invoices[days_late] )
			formatString: 0.0

		column invoice_id
			dataType: string
			isKey
			summarizeBy: none
			sourceColumn: invoice_id

		column date_day
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: date_day

		column customer_id
			dataType: string
			summarizeBy: none
			sourceColumn: customer_id

		column rep_id
			dataType: string
			summarizeBy: none
			sourceColumn: rep_id

		column due_date
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: due_date

		column payment_date
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: payment_date

		column invoice_amount
			dataType: double
			formatString: #,0 €
			summarizeBy: sum
			sourceColumn: invoice_amount

		column open_amount
			dataType: double
			formatString: #,0 €
			summarizeBy: sum
			sourceColumn: open_amount

		column days_late
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: days_late

		column days_overdue
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: days_overdue

		column aging_bucket
			dataType: string
			summarizeBy: none
			sourceColumn: aging_bucket
			sortByColumn: aging_sort

		column aging_sort
			dataType: int64
			isHidden
			formatString: 0
			summarizeBy: none
			sourceColumn: aging_sort

		partition fct_invoices = m
			mode: import
			source =
					let
						Source = Parquet.Document ( File.Contents ( DataFolder & "fct_invoices.parquet" ) )
					in
						Source

	relationship fct_sales_date
		fromColumn: fct_sales.date_day
		toColumn: dim_date.date_day

	relationship fct_sales_customer
		fromColumn: fct_sales.customer_id
		toColumn: dim_customer.customer_id

	relationship fct_sales_rep
		fromColumn: fct_sales.rep_id
		toColumn: dim_rep.rep_id

	relationship fct_sales_category
		fromColumn: fct_sales.category
		toColumn: dim_category.category

	relationship fct_visits_date
		fromColumn: fct_visits.date_day
		toColumn: dim_date.date_day

	relationship fct_visits_customer
		fromColumn: fct_visits.customer_id
		toColumn: dim_customer.customer_id

	relationship fct_visits_rep
		fromColumn: fct_visits.rep_id
		toColumn: dim_rep.rep_id

	relationship fct_invoices_date
		fromColumn: fct_invoices.date_day
		toColumn: dim_date.date_day

	relationship fct_invoices_customer
		fromColumn: fct_invoices.customer_id
		toColumn: dim_customer.customer_id

	relationship fct_invoices_rep
		fromColumn: fct_invoices.rep_id
		toColumn: dim_rep.rep_id
