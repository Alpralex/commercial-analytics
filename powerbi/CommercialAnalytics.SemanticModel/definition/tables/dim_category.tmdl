table dim_category

	column category
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: category

	column sku_count
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: sku_count

	column avg_list_margin_pct
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: avg_list_margin_pct

	partition dim_category = m
		mode: import
		source =
				let
					Source = Parquet.Document ( File.Contents ( DataFolder & "dim_category.parquet" ) )
				in
					Source
