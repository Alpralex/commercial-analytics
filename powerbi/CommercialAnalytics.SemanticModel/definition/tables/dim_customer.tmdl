table dim_customer

	measure 'Customers' = COUNTROWS ( dim_customer )
		formatString: #,0

	/// Customers whose last visit was more than 60 days before the snapshot date (30 Sep 2026).
	measure 'Customers Without Visit 60+' = CALCULATE ( COUNTROWS ( dim_customer ), dim_customer[visit_recency] = "No visit 60+ days" )
		formatString: #,0

	/// No visit for 60+ days and still ordering (last order within 180 days), as in the Qlik master item.
	measure 'Customers at Risk' =
			CALCULATE (
				COUNTROWS ( dim_customer ),
				dim_customer[visit_recency] = "No visit 60+ days",
				dim_customer[customer_status] IN { "Active", "Lapsing" }
			)
		formatString: #,0

	column customer_id
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: customer_id

	column customer_name
		dataType: string
		summarizeBy: none
		sourceColumn: customer_name

	column segment
		dataType: string
		summarizeBy: none
		sourceColumn: segment

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column district
		dataType: string
		summarizeBy: none
		sourceColumn: district

	column account_rep_id
		dataType: string
		summarizeBy: none
		sourceColumn: account_rep_id

	column customer_since
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: customer_since

	column payment_terms_days
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: payment_terms_days

	column last_visit_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: last_visit_date

	column last_order_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: last_order_date

	column days_since_visit
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: days_since_visit

	column days_since_order
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: days_since_order

	column days_since_visit_band
		dataType: string
		summarizeBy: none
		sourceColumn: days_since_visit_band

	column visit_recency
		dataType: string
		summarizeBy: none
		sourceColumn: visit_recency

	column customer_status
		dataType: string
		summarizeBy: none
		sourceColumn: customer_status

	column revenue_l12m
		dataType: double
		formatString: #,0 €
		summarizeBy: none
		sourceColumn: revenue_l12m

	partition dim_customer = m
		mode: import
		source =
				let
					Source = Parquet.Document ( File.Contents ( DataFolder & "dim_customer.parquet" ) )
				in
					Source
