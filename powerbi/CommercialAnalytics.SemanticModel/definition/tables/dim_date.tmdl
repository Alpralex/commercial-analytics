table dim_date
	dataCategory: Time

	column date_day
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date_day

	column year_number
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year_number

	column quarter_label
		dataType: string
		summarizeBy: none
		sourceColumn: quarter_label

	column month_number
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: month_number

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_number

	column month_start
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: month_start

	column year_month
		dataType: string
		summarizeBy: none
		sourceColumn: year_month

	column weekday_number
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: weekday_number

	column season
		dataType: string
		summarizeBy: none
		sourceColumn: season

	partition dim_date = m
		mode: import
		source =
				let
					Source = Parquet.Document ( File.Contents ( DataFolder & "dim_date.parquet" ) )
				in
					Source
